{
  "name": "chatapp",
  "version": "2.0.0",
  "description": "Real-time one-to-one chat application built on Express, Socket.IO and MongoDB.",
  "main": "server.js",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "test": "jest --runInBand",
    "test:coverage": "jest --runInBand --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/hasan-bekir-dogan/ChatApp.git"
  },
  "keywords": [
    "chat",
    "real-time",
    "messaging",
    "socket.io",
    "express",
    "mongodb",
    "nodejs",
    "websocket"
  ],
  "author": "Hasan Bekir Doğan",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/hasan-bekir-dogan/ChatApp/issues"
  },
  "homepage": "https://github.com/hasan-bekir-dogan/ChatApp#readme",
  "dependencies": {
    "bcrypt": "^6.0.0",
    "compression": "^1.7.4",
    "connect-flash": "^0.1.1",
    "connect-mongo": "^5.1.0",
    "dotenv": "^16.4.5",
    "ejs": "^6.0.1",
    "express": "^4.19.2",
    "express-fileupload": "^1.5.0",
    "express-rate-limit": "^8.7.0",
    "express-session": "^1.18.0",
    "express-validator": "^7.0.1",
    "helmet": "^8.3.0",
    "mongoose": "^8.3.2",
    "socket.io": "^4.7.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.12.0",
    "jest": "^30.5.1",
    "mongodb-memory-server": "^11.2.0",
    "nodemon": "^3.1.0",
    "prettier": "^3.2.5",
    "socket.io-client": "^4.8.3",
    "supertest": "^7.0.0"
  }
}
