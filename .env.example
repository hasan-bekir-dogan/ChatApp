# Copy this file to .env and adjust the values for your environment.
# .env is git-ignored and must never be committed.

# development | production | test
NODE_ENV=development

# Port the HTTP server listens on
PORT=3000

# MongoDB connection string (also used as the session store)
MONGODB_URI=mongodb://127.0.0.1:27017/chatapp

# Secret used to sign the session cookie.
# Required in production. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=insecure-development-secret

# Session lifetime in milliseconds (default: 7 days)
SESSION_MAX_AGE=604800000

# Maximum accepted size for an uploaded profile picture, in bytes (default: 2 MB)
UPLOAD_MAX_BYTES=2097152

# Set to true when running behind a reverse proxy (Heroku, Nginx, Fly.io, ...)
# so that secure cookies and rate limiting see the real client IP.
TRUST_PROXY=false
